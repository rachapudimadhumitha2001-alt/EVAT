{
  "name": "EVAT-Website",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the Electric Vehicle Application Tool (EVAT)",
  "workspaces": [
    "client/web-app",
    "server/node-api"
  ],
  "scripts": {
    "install:all": "npm install --include=optional && npm run python:sync",
    "dev": "npx concurrently -c \"#93c5fd,#c4b5fd\" \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:python\"  --names=client,server,python --kill-others",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run server --workspace=server",
    "python:sync": "uv sync --locked --project \"server/python-services\"",
    "train:charging-recommendation-model": "cd \"server/python-services\" && uv run --locked python charging_station_recommendation_api/training/retrain_preference_model.py",
    "dev:python": "cd \"server/python-services\" && uv run --locked python -m uvicorn main:app --host 127.0.0.1 --port 5000 --reload-exclude \".venv\"",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:python": "cd \"server/python-services\" && uv run --locked python -m pytest"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@bramus/specificity": "^2.4.2",
    "@csstools/css-calc": "^3.4.2",
    "@csstools/css-color-parser": "^4.2.5",
    "@csstools/css-syntax-patches-for-csstree": "^1.1.3",
    "@csstools/css-tokenizer": "^4.0.2",
    "entities": "^8.1.0",
    "symbol-tree": "^3.2.4"
  }
}
